# Production values for compose.yaml. Copy to .env (never commit it) and replace
# every placeholder. Generate secrets with `openssl rand -hex 32`; hex keeps them
# safe inside the DATABASE_URL connection string.
APP_VERSION=replace-with-release-git-sha
SITE_DOMAIN=store.example.com
API_DOMAIN=api.example.com
SITE_URL=https://store.example.com
API_URL=https://api.example.com
WHATSAPP_NUMBER=replace-with-business-number-digits
ADMIN_API_KEY=replace-with-openssl-rand-hex-32
INTERNAL_API_TOKEN=replace-with-openssl-rand-hex-32
POSTGRES_DB=elegance_shawls
POSTGRES_ADMIN_USER=elegance_admin
POSTGRES_ADMIN_PASSWORD=replace-with-openssl-rand-hex-32
POSTGRES_APP_USER=elegance_app
POSTGRES_APP_PASSWORD=replace-with-openssl-rand-hex-32
POSTGRES_BACKUP_USER=elegance_backup
POSTGRES_BACKUP_PASSWORD=replace-with-openssl-rand-hex-32
