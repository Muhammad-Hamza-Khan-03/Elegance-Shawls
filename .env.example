# Production values for compose.yaml. Copy to .env (never commit it) and replace
# every placeholder. Generate secrets with `openssl rand -hex 32`; hex keeps them
# safe inside the DATABASE_URL connection string.
APP_VERSION=replace-with-release-git-sha
SITE_DOMAIN=store.example.com
API_DOMAIN=api.example.com
SITE_URL=https://store.example.com
API_URL=https://api.example.com
WHATSAPP_NUMBER=replace-with-business-number-digits
# Legacy shared key: leave both empty. It is honoured only while ADMIN_LEGACY_KEY_EXPIRES_AT is a future ISO-8601 instant with offset.
ADMIN_API_KEY=
ADMIN_LEGACY_KEY_EXPIRES_AT=
INTERNAL_API_TOKEN=replace-with-openssl-rand-hex-32
POSTGRES_DB=elegance_shawls
POSTGRES_ADMIN_USER=elegance_admin
POSTGRES_ADMIN_PASSWORD=replace-with-openssl-rand-hex-32
POSTGRES_APP_USER=elegance_app
POSTGRES_APP_PASSWORD=replace-with-openssl-rand-hex-32
POSTGRES_BACKUP_USER=elegance_backup
POSTGRES_BACKUP_PASSWORD=replace-with-openssl-rand-hex-32

# Backup tooling (apps/backend/scripts/pg_backup.py) reads these from the operator's shell or secret manager, not from compose.
# Leave unset until the owner has approved an off-server destination (OPERATIONS.md "Backup and restore"). Never commit values.
# BACKUP_DATABASE_URL=postgresql://elegance_backup:<POSTGRES_BACKUP_PASSWORD>@localhost:5432/elegance_shawls
# BACKUP_ENCRYPTION_PASSPHRASE=replace-with-openssl-rand-hex-32   (or BACKUP_ENCRYPTION_PASSPHRASE_FILE=/path/owner-only-file)
# BACKUP_STORE_DIR=   (local/disposable only; the S3-compatible adapter is not implemented)

# Optional WhatsApp bridge (docker compose --profile whatsapp). false = wa.me link mode, exactly as before.
WHATSAPP_BRIDGE_ENABLED=false
WHATSAPP_BRIDGE_TOKEN=replace-with-openssl-rand-hex-32
REDIS_PASSWORD=replace-with-openssl-rand-hex-32
WHATSAPP_BOT_PAUSE_HOURS=12
# Comma-separated numbers; when set the bot replies only to these (rollout guard). Empty = every eligible chat.
WHATSAPP_REPLY_ALLOWLIST=
WHATSAPP_SEND_RATE_PER_MIN=20
# Phase 3-4 (all off by default). Assistant: a model (LLM gateway; outside development only the no-training LLM_PRODUCTION_CHAIN) understands
# every WhatsApp message, searches the catalogue, places order enquiries and collects delivery details. No chain configured = holding reply.
WHATSAPP_ASSISTANT_ENABLED=false
# Voice notes: needs a SELF-HOSTED (or no-training) OpenAI-compatible transcription endpoint, declared in WHATSAPP_ASR_PRIVACY.
WHATSAPP_VOICE_ENABLED=false
WHATSAPP_ASR_URL=
WHATSAPP_ASR_MODEL=whisper-1
WHATSAPP_ASR_API_KEY=
WHATSAPP_ASR_PRIVACY=
# Auth state: file (default) or postgres (needs migration 0020, deploy/postgres/whatsapp-auth-role.sh, and a key the database never sees).
WHATSAPP_AUTH_STORE=file
WHATSAPP_AUTH_DATABASE_URL=
WHATSAPP_AUTH_ENCRYPTION_KEY=
# Photos -> similar products: LOCAL CLIP model only (see README "Photos"). Off by default.
WHATSAPP_IMAGE_ENABLED=false
IMAGE_MATCH_MODEL_PATH=
IMAGE_MATCH_MODEL_REVISION=
IMAGE_MATCH_MIN_SIMILARITY=0.8
IMAGE_MATCH_MAX_RESULTS=3
