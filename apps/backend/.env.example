# PostgreSQL (required). Create the schema first: `alembic upgrade head`. Local server: compose.ai.yaml.
DATABASE_URL=postgresql+asyncpg://elegance_app:replace-with-app-password@localhost:5432/elegance_shawls
ALLOWED_ORIGINS=http://localhost:3000
# Legacy shared key: leave both empty. It is honoured only while ADMIN_LEGACY_KEY_EXPIRES_AT is a future ISO-8601 instant with offset.
ADMIN_API_KEY=
ADMIN_LEGACY_KEY_EXPIRES_AT=
ENVIRONMENT=development
PUBLIC_RATE_LIMIT_PER_MINUTE=120
ADMIN_RATE_LIMIT_PER_MINUTE=60

# Phase 1 ingestion (leave unset until a source is explicitly authorized)
INGESTION_SOURCE_ID=primary
INGESTION_SOURCE_NAME=
INGESTION_SOURCE_DOMAIN=
INGESTION_SOURCE_AUTHORIZED=false
INGESTION_IMAGE_HOSTS=
INGESTION_ALLOWED_HOSTS=
# One-shot refresh (python -m ingestion.worker --once). Defaults shown; the database name must contain "staging".
# INGESTION_SITEMAP_PATH=/sitemap.xml
# INGESTION_MAX_URLS_PER_SOURCE=500
# INGESTION_RUN_MAX_SECONDS=2700

# Inside the compose network the host name is the compose service: ...@postgres:5432/elegance_shawls

# Redis / arq worker for new AI workloads (empty = disabled; rate limits then stay in-process)
# REDIS_URL=redis://:replace-with-redis-password@redis:6379/0
# WORKER_QUEUE=elegance:ai:default
# WORKER_MAX_JOBS=4
# WORKER_JOB_TIMEOUT_SECONDS=120
# WORKER_MAX_TRIES=3

# Anonymous interaction events (empty key = POST /v1/events answers 503). Use `openssl rand -hex 32`.
# SESSION_SIGNING_KEY=
# EVENTS_RATE_LIMIT_PER_MINUTE=30
# EVENTS_RETENTION_MONTHS=18

# LLM gateway. Keys are provider env vars (GROQ_API_KEY, GEMINI_API_KEY, ...) and are never committed.
# Real providers need `pip install -r requirements-llm.txt`; fake/ models need nothing.
# LLM_CHAIN_DEFAULT=groq/openai/gpt-oss-120b,gemini/gemini-2.5-flash,ollama/qwen2.5
# LLM_PRODUCTION_CHAIN=            # personal data is routed here only; free tiers are filtered out
# LLM_PROVIDER_TRAINING_POLICIES=  # customer-memory gate: provider=no_training|self_hosted to allow; opt_out, may_train, unknown or empty = denied
# LLM_DAILY_BUDGET_USD=1.0
# LLM_ENVIRONMENT_BUDGET_USD=10.0
# Discovery cache defaults: fresh 6h, serve stale up to 48h; requests are bounded and retried only for timeout/429/5xx.
# LLM_DISCOVERY_FRESH_TTL_SECONDS=21600
# LLM_DISCOVERY_STALE_CEILING_SECONDS=172800
# LLM_DISCOVERY_TIMEOUT_SECONDS=5
# LLM_DISCOVERY_MAX_ATTEMPTS=3
# LLM_DISCOVERY_RETRY_AFTER_CAP_SECONDS=2

# Tracing exporters stay off unless enabled and an OTLP endpoint is set.
# OTEL_ENABLED=false

# Optional Langfuse LLM tracing (needs requirements-llm.txt). Off unless all three are set.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# Built-in providers read their keys from the environment (never commit them):
# GROQ_API_KEY=  GEMINI_API_KEY=  OPENROUTER_API_KEY=   (OLLAMA_BASE_URL=http://localhost:11434/v1 for a local model)
# Cost when a provider reports none; 0 = unpriced. Set these before routing paid traffic.
# LLM_PRICE_PER_MILLION_INPUT_USD=0
# LLM_PRICE_PER_MILLION_OUTPUT_USD=0

# Assistant answers from the live catalogue (parser + search) instead of the scripted demo.
ASSISTANT_CATALOGUE=false

# Semantic search (local multilingual-e5-base on CPU; optional). Needs requirements-local-e5.txt, scripts/fetch_e5_model.py, then scripts/embedding_backfill.py.
# SEMANTIC_EMBEDDING_PROVIDER=local_e5
# SEMANTIC_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# SEMANTIC_EMBEDDING_DIMENSIONS=768
# SEMANTIC_E5_MODEL_PATH=/path/to/multilingual-e5-base

# Assistant wording from an LLM (ASSISTANT_LLM=true also needs LLM_CHAIN_DEFAULT and the provider key above). Off = fixed sentences.
ASSISTANT_LLM=false

# Customer sign-in with Google (all five, plus NEXT_PUBLIC_GOOGLE_CLIENT_ID on the storefront):
# CUSTOMER_AUTH_ENABLED=true
# CUSTOMER_AUTH_PROVIDER=google
# CUSTOMER_AUTH_ISSUER=https://accounts.google.com
# CUSTOMER_AUTH_AUDIENCE=<your Google OAuth client id>
# CUSTOMER_AUTH_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# Off-topic queries (no shopping word) keep semantic neighbours only within this cosine distance (evals/roman_urdu_retrieval_eval.py).
# SEMANTIC_MAX_DISTANCE=0.18
