MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=elegance_shawls
ALLOWED_ORIGINS=http://localhost:3000
ADMIN_API_KEY=replace-with-a-long-random-secret
ENVIRONMENT=development
PUBLIC_RATE_LIMIT_PER_MINUTE=120
ADMIN_RATE_LIMIT_PER_MINUTE=60

# Phase 1 ingestion (leave unset until a source is explicitly authorized)
INGESTION_SOURCE_ID=primary
INGESTION_SOURCE_NAME=
INGESTION_SOURCE_DOMAIN=
INGESTION_SOURCE_AUTHORIZED=false
INGESTION_IMAGE_HOSTS=
INGESTION_ALLOWED_HOSTS=
# One-shot refresh (python -m ingestion.worker --once). Defaults shown; the database name must contain "staging".
# INGESTION_SITEMAP_PATH=/sitemap.xml
# INGESTION_MAX_URLS_PER_SOURCE=500
# INGESTION_RUN_MAX_SECONDS=2700
