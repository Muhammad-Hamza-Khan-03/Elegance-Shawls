NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admins sign in with individual accounts held by the backend; the frontend holds no admin secret.

# Storefront assistant (off by default). The backend must also run with ASSISTANT_CATALOGUE=true to answer from real products.
NEXT_PUBLIC_ASSISTANT_ENABLED=

# Optional customer sign-in (Google). The same OAuth client id must be the backend CUSTOMER_AUTH_AUDIENCE.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Comma-separated hostnames allowed for remote product images (build time); empty = any HTTPS host (see DEPLOYMENT.md, #80)
IMAGE_ALLOWED_HOSTS=
