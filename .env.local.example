# Local HTTPS acceptance stack (compose.yaml + compose.local.yaml). Copy to
# .env.local and replace the secret placeholders with `openssl rand -hex 32`.
APP_VERSION=local
SITE_DOMAIN=store.localhost
API_DOMAIN=api.localhost
HTTP_PORT=8080
HTTPS_PORT=8443
PROXY_BIND=127.0.0.1
CADDY_GLOBAL_OPTIONS=local_certs
SITE_URL=https://store.localhost:8443
API_URL=https://api.localhost:8443
WHATSAPP_NUMBER=923001234567
ADMIN_API_KEY=replace-with-openssl-rand-hex-32
MONGO_DB_NAME=elegance_shawls
MONGO_ROOT_USERNAME=elegance_root
MONGO_ROOT_PASSWORD=replace-with-openssl-rand-hex-32
MONGO_APP_USERNAME=elegance_app
MONGO_APP_PASSWORD=replace-with-openssl-rand-hex-32
MONGO_BACKUP_USERNAME=elegance_backup
MONGO_BACKUP_PASSWORD=replace-with-openssl-rand-hex-32
# Live acceptance tests create fixtures and render many pages from one client
# and one frontend server IP; production keeps the defaults (120 / 60).
PUBLIC_RATE_LIMIT_PER_MINUTE=2000
ADMIN_RATE_LIMIT_PER_MINUTE=600
