# Local HTTPS acceptance stack (compose.yaml + compose.local.yaml). Copy to
# .env.local and replace the secret placeholders with `openssl rand -hex 32`.
APP_VERSION=local
SITE_DOMAIN=store.localhost
API_DOMAIN=api.localhost
HTTP_PORT=8080
HTTPS_PORT=8443
PROXY_BIND=127.0.0.1
CADDY_GLOBAL_OPTIONS=local_certs
SITE_URL=https://store.localhost:8443
API_URL=https://api.localhost:8443
WHATSAPP_NUMBER=923001234567
# Legacy shared key: leave both empty. It is honoured only while ADMIN_LEGACY_KEY_EXPIRES_AT is a future ISO-8601 instant with offset.
ADMIN_API_KEY=
ADMIN_LEGACY_KEY_EXPIRES_AT=
INTERNAL_API_TOKEN=replace-with-openssl-rand-hex-32
POSTGRES_DB=elegance_shawls
POSTGRES_ADMIN_USER=elegance_admin
POSTGRES_ADMIN_PASSWORD=replace-with-openssl-rand-hex-32
POSTGRES_APP_USER=elegance_app
POSTGRES_APP_PASSWORD=replace-with-openssl-rand-hex-32
POSTGRES_BACKUP_USER=elegance_backup
POSTGRES_BACKUP_PASSWORD=replace-with-openssl-rand-hex-32
# Live acceptance tests create fixtures through the admin API faster than one
# real admin would; production keeps the default (60).
ADMIN_RATE_LIMIT_PER_MINUTE=600
